# Endpoint compatible con OpenAI (9router, OpenRouter, Ollama...)
ROUTER_BASE_URL=https://your-router.example.com/v1
ROUTER_API_KEY=
ROUTER_MODEL=guria-intake

# Estimación interna: horas del modelo × tarifa (USD/h)
TARIFA_USD_HORA=25-45
HORAS_SEMANA=25

# Opcional: carpeta de la base SQLite y los borradores (default: data)
INTAKE_DATA=

# Búsqueda en internet en el workflow (opcional: sin key, se redacta sin buscar)
TAVILY_API_KEY=

# Aviso al equipo por email (Resend por SMTP: usuario "resend", la API key re_... como clave)
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=
SMTP_FROM=intake@tu-dominio-verificado.com
AVISOS_EMAIL=

# Link de agenda del pitch (Cal.com); el código le agrega nombre y email del cliente
AGENDA_URL=https://cal.com/knaimero/pitch-intake

# Opcional: Chrome/Chromium para los PDF (si falta, se adjunta el HTML)
CHROMIUM_BIN=

# Backoffice (Streamlit): un solo usuario
ADMIN_USER=
ADMIN_PASSWORD=
